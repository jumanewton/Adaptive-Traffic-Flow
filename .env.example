# Adaptive Traffic Flow Lab - Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# VISION / PERCEPTION
# =============================================================================
# Model settings
VISION_MODEL_NAME=yolov8n.pt
# VISION_MODEL_PATH=/path/to/custom/model.pt
VISION_DEVICE=auto          # auto, cpu, cuda, mps
VISION_HALF_PRECISION=false

# Inference thresholds
VISION_CONFIDENCE_THRESHOLD=0.25
VISION_IOU_THRESHOLD=0.45
VISION_MAX_DET=300
VISION_IMG_SIZE=640

# Classes to detect (COCO: 0=person, 2=car, 3=motorcycle, 5=bus, 7=truck)
VISION_CLASSES=2,3,5,7
VISION_PEDESTRIAN_CLASS=0

# Camera
VISION_CAMERA_ID=cam_01
VISION_CAMERA_FPS=30
VISION_CAMERA_RESOLUTION=1920,1080

# Calibration
# VISION_CALIBRATION_FILE=configs/calibration/cam_01.yaml
VISION_ENABLE_CALIBRATION=true

# =============================================================================
# TRACKING (ByteTrack)
# =============================================================================
TRACKING_TRACK_THRESH=0.5
TRACKING_TRACK_BUFFER=30
TRACKING_MATCH_THRESH=0.8
TRACKING_MIN_BOX_AREA=10.0
TRACKING_MOT20=false

TRACKING_MAX_AGE=30
TRACKING_MIN_HITS=3
TRACKING_IOU_THRESHOLD=0.3
TRACKING_USE_KALMAN=true

# =============================================================================
# TRAFFIC STATE ESTIMATION
# =============================================================================
TRAFFIC_QUEUE_DETECTION_DISTANCE_M=10.0
TRAFFIC_MIN_SPEED_QUEUED_KMH=5.0
TRAFFIC_OCCUPANCY_TIME_WINDOW_S=5.0
TRAFFIC_SPEED_SMOOTHING_ALPHA=0.3
TRAFFIC_MIN_TRACK_LENGTH_FOR_SPEED=5
TRAFFIC_LANE_ASSIGNMENT_TOLERANCE_M=1.5
TRAFFIC_STATE_UPDATE_INTERVAL_S=1.0

# =============================================================================
# CONTROL
# =============================================================================
# Controller type: fixed_time, max_pressure, mpc, rl
CONTROL_CONTROLLER_TYPE=max_pressure

# Fixed-time settings
CONTROL_FIXED_TIME_CYCLE_LENGTH=120
# CONTROL_FIXED_TIME_PHASE_SPLITS={"north_south": 50, "east_west": 50}

# Max-pressure settings
CONTROL_MAX_PRESSURE_MIN_GREEN=10
CONTROL_MAX_PRESSURE_MAX_GREEN=60
CONTROL_MAX_PRESSURE_PRESSURE_WEIGHT=1.0
CONTROL_MAX_PRESSURE_DOWNSTREAM_WEIGHT=0.5

# Safety constraints (always enforced)
CONTROL_MIN_GREEN_TIME=7
CONTROL_MAX_GREEN_TIME=120
CONTROL_YELLOW_TIME=3
CONTROL_ALL_RED_TIME=2
CONTROL_PEDESTRIAN_WALK_TIME=7
CONTROL_PEDESTRIAN_CLEARANCE_TIME=10

# Emergency vehicle
CONTROL_EMERGENCY_PREEMPT_ENABLED=true
CONTROL_EMERGENCY_CLEARANCE_TIME=5

# Control loop
CONTROL_CONTROL_LOOP_INTERVAL_S=1.0

# =============================================================================
# SIMULATION (SUMO)
# =============================================================================
# SIM_SUMO_HOME=/usr/share/sumo
SIM_SUMO_BINARY=sumo
SIM_SUMO_GUI_BINARY=sumo-gui

# SIM_NETWORK_FILE=simulation/sumo/networks/simple_intersection.net.xml
# SIM_ROUTE_FILE=simulation/sumo/routes/peak_hour.rou.xml

SIM_STEP_LENGTH=1.0
SIM_SIMULATION_DURATION=3600
SIM_SEED=42

SIM_TRACI_PORT=8813
SIM_TRACI_HOST=localhost

SIM_OUTPUT_DIR=simulation/output
SIM_EMIT_FCD=false
SIM_EMIT_QUEUE=true
SIM_EMIT_EMISSIONS=true

# =============================================================================
# STREAMING (Kafka/Redpanda)
# =============================================================================
STREAM_BOOTSTRAP_SERVERS=localhost:9092
STREAM_CLIENT_ID=traffic-lab

STREAM_TRAFFIC_STATE_TOPIC=traffic.state
STREAM_CONTROLLER_ACTION_TOPIC=traffic.control.action
STREAM_PHASE_CHANGE_TOPIC=traffic.phase.change
STREAM_INCIDENT_TOPIC=traffic.incident

STREAM_ACKS=all
STREAM_RETRIES=3
STREAM_LINGER_MS=5
STREAM_COMPRESSION_TYPE=lz4

STREAM_GROUP_ID=traffic-lab-consumer
STREAM_AUTO_OFFSET_RESET=latest
STREAM_ENABLE_AUTO_COMMIT=true

# STREAM_SCHEMA_REGISTRY_URL=http://localhost:8081

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_DATABASE_URL=postgresql://traffic:traffic@localhost:5432/traffic_lab
# STORAGE_CLICKHOUSE_URL=http://localhost:8123
# STORAGE_TIMESERIES_URL=postgresql://traffic:traffic@localhost:5432/traffic_timeseries

STORAGE_S3_ENDPOINT=localhost:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_BUCKET=traffic-lab
STORAGE_S3_REGION=us-east-1
STORAGE_S3_SECURE=false

STORAGE_DATA_DIR=data
STORAGE_MODELS_DIR=models
STORAGE_EXPORTS_DIR=models/exports

# =============================================================================
# OBSERVABILITY
# =============================================================================
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=false
# OBS_LOG_FILE=logs/traffic-lab.log

OBS_METRICS_ENABLED=true
OBS_METRICS_PORT=9090
OBS_METRICS_PATH=/metrics

OBS_TRACING_ENABLED=true
# OBS_OTLP_ENDPOINT=localhost:4317
OBS_CONSOLE_EXPORT=false

OBS_SERVICE_NAME=traffic-lab
OBS_ENVIRONMENT=development