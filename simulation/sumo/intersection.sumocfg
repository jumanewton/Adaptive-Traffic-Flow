<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <input>
    <net-file value="intersection.net.xml"/>
    <route-files value="intersection.rou.xml"/>
  </input>

  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="1.0"/>
  </time>

  <processing>
    <seed value="42"/>
    <ignore-route-errors value="true"/>
    <time-to-teleport value="-1"/>
  </processing>

  <report>
    <verbose value="true"/>
    <no-step-log value="true"/>
    <duration-log.disable value="true"/>
  </report>

  <output>
    <queue-output value="output/queue.xml"/>
    <emission-output value="output/emissions.xml"/>
    <fcd-output value="output/fcd.xml"/>
    <summary-output value="output/summary.xml"/>
  </output>

  <gui_only>
    <gui-settings-file value="gui_settings.xml"/>
  </gui_only>
</configuration>